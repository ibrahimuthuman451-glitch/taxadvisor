# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server only, never exposed to the browser. Required to
# persist annexures / reconciliation runs from API routes.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta). When unset, /api/whatsapp/send runs in dry-run
# mode and returns the rendered payload without calling Meta.
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Optional: pre-approved template names. If omitted, a plain text message is
# sent (allowed inside the 24h customer-service window).
WHATSAPP_TEMPLATE_LANG=en

# ---------------------------------------------------------------------------
# Local SMS gateway (e.g. Africa's Talking / local aggregator HTTP bridge)
# ---------------------------------------------------------------------------
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=TaxOpsRW

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
